<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0a0c10">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Interbus">
<meta name="mobile-web-app-capable" content="yes">
<link rel="icon" type="image/png" href="icons/icon-192.png">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<title>Interbus – Horarios</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#000000;
    --panel:#0a0e14;
    --card:#0d1520;
    --border:#1a3a5c;
    --blue:#1565c0;
    --blue-light:#2196f3;
    --cyan:#29b6f6;
    --white:#ffffff;
    --white-dim:#cce4f7;
    --red:#ff4d4d;
    --green:#3ecf8e;
    --text:#e8f4fd;
    --muted:#5b8db8;
    --font-head:'Bebas Neue',sans-serif;
    --font-mono:'IBM Plex Mono',monospace;
    --font-body:'IBM Plex Sans',sans-serif;
  }
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  html,body { height:100%; overscroll-behavior:none; }
  body { background:var(--bg); color:var(--text); font-family:var(--font-body); min-height:100vh; overflow-x:hidden; }

  /* Header */
  header {
    background:linear-gradient(135deg, #0a0e14 0%, #0d1a2e 100%);
    border-bottom:2px solid var(--blue);
    padding:12px 16px;
    display:flex; align-items:center; gap:12px;
    position:sticky; top:0; z-index:100;
    box-shadow:0 2px 20px rgba(33,150,243,0.2);
  }
  .header-bus { width:56px; height:56px; object-fit:contain; filter:drop-shadow(0 0 8px rgba(41,182,246,0.5)); }
  .logo-wrap { display:flex; flex-direction:column; justify-content:center; }
  .logo { font-family:var(--font-head); font-size:2rem; letter-spacing:4px; line-height:1;
    background:linear-gradient(90deg,#ffffff,#29b6f6);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
  .logo-sub { font-family:var(--font-mono); font-size:0.55rem; letter-spacing:5px; color:var(--cyan); opacity:0.8; text-transform:uppercase; margin-top:1px; }
  #clock-box { margin-left:auto; text-align:right; }
  #clock { font-family:var(--font-mono); font-size:1.5rem; font-weight:600; color:var(--cyan); letter-spacing:2px; text-shadow:0 0 12px rgba(41,182,246,0.5); }
  #date-label { font-size:0.55rem; color:var(--muted); letter-spacing:2px; text-transform:uppercase; margin-top:2px; }

  .main { max-width:680px; margin:0 auto; padding:16px 14px 20px; }

  /* GPS */
  .gps-bar { display:flex; align-items:center; gap:10px; background:var(--card); border:1px solid var(--border); border-radius:8px; padding:11px 14px; margin-bottom:10px; font-size:0.78rem; color:var(--muted); font-family:var(--font-mono); }
  .gps-dot { width:8px; height:8px; border-radius:50%; background:var(--muted); flex-shrink:0; transition:background 0.4s; }
  .gps-dot.active { background:var(--green); box-shadow:0 0 8px var(--green); animation:pulse 2s infinite; }
  .gps-dot.error { background:var(--red); }
  @keyframes pulse { 0%,100%{opacity:1}50%{opacity:0.4} }
  @keyframes fadeIn { from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none} }
  #gps-text { flex:1; font-size:0.75rem; color:var(--white-dim); }
  #gps-btn { background:transparent; border:1px solid var(--blue); color:var(--cyan); font-family:var(--font-mono); font-size:0.72rem; padding:5px 11px; border-radius:4px; cursor:pointer; transition:all 0.2s; letter-spacing:1px; }
  #gps-btn:active { background:rgba(41,182,246,0.12); }
  .gps-instrucciones { background:rgba(255,77,77,0.08); border:1px solid rgba(255,77,77,0.3); border-radius:8px; padding:13px 15px; margin-bottom:14px; font-size:0.79rem; color:var(--text); line-height:1.7; animation:fadeIn 0.3s ease; }
  .gps-instrucciones strong { color:#ff8080; }
  .gps-instrucciones ol { margin:7px 0 0 17px; }
  .gps-instrucciones li { margin-bottom:3px; }

  /* Controls */
  .controls { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px; }
  .field { display:flex; flex-direction:column; gap:5px; }
  label { font-size:0.62rem; letter-spacing:3px; text-transform:uppercase; color:var(--cyan); font-family:var(--font-mono); opacity:0.8; }
  select, input[type="time"] {
    background:var(--card); border:1px solid var(--border); color:var(--white);
    font-family:var(--font-mono); font-size:0.92rem; padding:10px 11px;
    border-radius:6px; outline:none; transition:border-color 0.2s; width:100%;
    -webkit-appearance:none; appearance:none;
  }
  select:focus, input:focus { border-color:var(--cyan); box-shadow:0 0 0 2px rgba(41,182,246,0.15); }
  select option { background:#0d1520; color:#fff; }
  .controls-row { display:flex; gap:10px; margin-bottom:18px; }
  #btn-consultar { flex:1; background:linear-gradient(135deg,var(--blue),var(--blue-light)); color:#fff; font-family:var(--font-head); font-size:1.35rem; letter-spacing:3px; border:none; border-radius:6px; padding:14px; cursor:pointer; transition:all 0.15s; box-shadow:0 4px 15px rgba(33,150,243,0.3); }
  #btn-consultar:active { transform:scale(0.98); opacity:0.9; }
  #btn-ahora { background:transparent; border:1px solid var(--cyan); color:var(--cyan); font-family:var(--font-mono); font-size:0.78rem; padding:14px 13px; border-radius:6px; cursor:pointer; letter-spacing:1px; transition:all 0.15s; white-space:nowrap; }
  #btn-ahora:active { background:rgba(41,182,246,0.1); }

  /* Results */
  .result-header { display:flex; align-items:baseline; gap:12px; margin-bottom:14px; padding-bottom:12px; border-bottom:1px solid var(--border); }
  .result-title { font-family:var(--font-head); font-size:1.45rem; letter-spacing:2px; color:var(--white); }
  .result-subtitle { font-size:0.68rem; color:var(--muted); font-family:var(--font-mono); letter-spacing:2px; }
  .next-badge { margin-left:auto; background:var(--blue-light); color:#fff; font-family:var(--font-mono); font-size:0.67rem; font-weight:600; padding:3px 10px; border-radius:20px; letter-spacing:1px; flex-shrink:0; }
  .schedule-grid { display:flex; flex-direction:column; gap:8px; }
  .bus-row { display:flex; align-items:center; gap:11px; background:var(--card); border:1px solid var(--border); border-radius:8px; padding:13px 14px; position:relative; overflow:hidden; transition:all 0.2s; }
  .bus-row.next { border-color:var(--cyan); background:rgba(41,182,246,0.07); box-shadow:0 0 12px rgba(41,182,246,0.1); }
  .bus-row.next::before { content:'PRÓXIMO'; position:absolute; top:0; right:0; background:var(--cyan); color:#000; font-family:var(--font-mono); font-size:0.58rem; font-weight:600; padding:2px 8px; letter-spacing:2px; border-bottom-left-radius:6px; }
  .bus-row.soon { border-color:var(--blue-light); }
  .bus-time { font-family:var(--font-mono); font-size:1.55rem; font-weight:600; min-width:68px; color:var(--white); }
  .bus-row.next .bus-time { color:var(--cyan); text-shadow:0 0 10px rgba(41,182,246,0.5); }
  .bus-row.soon .bus-time { color:var(--blue-light); }
  .bus-info { flex:1; }
  .bus-linea { font-size:0.65rem; color:var(--muted); letter-spacing:2px; text-transform:uppercase; font-family:var(--font-mono); }
  .p-badge { font-size:0.58rem; background:rgba(255,255,255,0.08); color:var(--white-dim); border:1px solid rgba(255,255,255,0.2); border-radius:3px; padding:2px 6px; font-family:var(--font-mono); letter-spacing:0.5px; flex-shrink:0; }
  .bus-countdown { font-family:var(--font-mono); font-size:0.78rem; color:var(--muted); text-align:right; min-width:62px; }
  .bus-row.next .bus-countdown { color:var(--cyan); }
  .bus-row.soon .bus-countdown { color:var(--blue-light); }
  .empty-state { text-align:center; padding:44px 20px; color:var(--muted); font-family:var(--font-mono); font-size:0.78rem; letter-spacing:2px; line-height:2.2; }
  .empty-icon { font-size:2.2rem; display:block; margin-bottom:10px; opacity:0.3; }
  #btn-nueva { width:100%; margin-top:18px; background:transparent; border:1px solid var(--border); color:var(--muted); font-family:var(--font-mono); font-size:0.8rem; letter-spacing:2px; padding:13px; border-radius:6px; cursor:pointer; transition:all 0.2s; }
  #btn-nueva:active { border-color:var(--cyan); color:var(--cyan); }

  /* Install banner */
  #install-banner { display:none; align-items:center; gap:10px; background:rgba(33,150,243,0.1); border:1px solid rgba(33,150,243,0.3); border-radius:8px; padding:11px 14px; margin-bottom:14px; font-size:0.78rem; font-family:var(--font-mono); color:var(--cyan); animation:fadeIn 0.3s ease; }
  #install-banner.show { display:flex; }
  #btn-install { background:var(--blue-light); color:#fff; border:none; font-family:var(--font-mono); font-size:0.72rem; font-weight:600; padding:5px 12px; border-radius:4px; cursor:pointer; letter-spacing:1px; flex-shrink:0; }



  /* Linea tabs */
  .linea-tab {
    flex:1; padding:12px 8px; border-radius:6px; cursor:pointer;
    font-family:var(--font-mono); font-size:0.85rem; letter-spacing:2px;
    border:2px solid var(--border); background:var(--card); color:var(--muted);
    transition:all 0.2s; font-weight:600;
  }
  .linea-tab.active {
    background:linear-gradient(135deg,var(--blue),var(--blue-light));
    border-color:var(--cyan); color:#fff;
    box-shadow:0 0 12px rgba(41,182,246,0.3);
  }
  .linea-tab:active { transform:scale(0.97); }
  /* Destination selector */
  .dest-row { display:flex; gap:10px; margin-bottom:12px; align-items:flex-end; }
  .dest-row .field { flex:1; }
  
  /* Map */
  #map-container { display:none; border-radius:8px; overflow:hidden; border:1px solid var(--border); margin-bottom:14px; animation:fadeIn 0.3s ease; }
  #map-container.show { display:block; }
  #map { height:200px; width:100%; }
  .map-label { background:var(--card); border-top:1px solid var(--border); padding:8px 12px; font-family:var(--font-mono); font-size:0.7rem; color:var(--muted); }

  /* Download button */
  #btn-download { width:100%; background:transparent; border:1px solid var(--blue); color:var(--cyan); font-family:var(--font-mono); font-size:0.78rem; letter-spacing:2px; padding:12px; border-radius:6px; cursor:pointer; transition:all 0.2s; margin-bottom:12px; display:flex; align-items:center; justify-content:center; gap:8px; }
  #btn-download:active { background:rgba(41,182,246,0.1); }

  /* Arrival info in results */
  .arrival-info { font-size:0.65rem; color:var(--cyan); font-family:var(--font-mono); margin-top:3px; letter-spacing:0.5px; }
  /* Footer */
  .footer { text-align:center; padding:20px 0 10px; font-family:var(--font-mono); font-size:0.6rem; letter-spacing:3px; color:var(--muted); text-transform:uppercase; opacity:0.6; border-top:1px solid var(--border); margin-top:24px; }
  .footer span { color:var(--cyan); }
</style>
</head>
<body>

<header>
  <img src="data:image/png;base64," class="header-bus" alt="Interbus">
  <div class="logo-wrap">
    <div class="logo">INTERBUS</div>
    <div class="logo-sub">Horarios de colectivos</div>
  </div>
  <div id="clock-box">
    <div id="clock">--:--:--</div>
    <div id="date-label">cargando...</div>
  </div>
</header>

<div class="main">

  <!-- Install banner -->
  <div id="install-banner">
    <span>📲 Instalá la app en tu pantalla de inicio</span>
    <button id="btn-install">INSTALAR</button>
  </div>


  <!-- Download button -->
  <a id="btn-download" href="data:image/png;base64," download="interbus-horarios.png">
    📥 DESCARGAR HORARIO COMPLETO
  </a>

  <!-- Map -->
  <div id="map-container">
    <div id="map"></div>
    <div class="map-label" id="map-label">Ubicación detectada</div>
  </div>

  <!-- GPS -->
  <div class="gps-bar">
    <div class="gps-dot" id="gps-dot"></div>
    <div id="gps-text">Ubicación no detectada</div>
    <button id="gps-btn" onclick="getLocation()">📡 DETECTAR</button>
  </div>
  <div id="gps-extra"></div>

  <!-- Controls -->

  <!-- 1. LINEA TABS (full width) -->
  <div style="display:flex;gap:8px;margin-bottom:12px;">
    <button class="linea-tab active" id="tab-alvarez" onclick="setLinea('alvarez')">🚌 ÁLVAREZ</button>
    <button class="linea-tab" id="tab-acebal" onclick="setLinea('acebal')">🚌 ACEBAL</button>
  </div>

  <!-- Hidden linea/dir values -->
  <input type="hidden" id="sel-linea" value="alvarez">
  <input type="hidden" id="sel-dir" value="">

  <!-- 2. ORIGEN → DESTINO -->
  <div style="display:flex;align-items:flex-end;gap:8px;margin-bottom:12px;">
    <div class="field" style="flex:1;">
      <label>Origen</label>
      <select id="sel-origen" onchange="onOrigenChange()">
        <option value="">— Elegí —</option>
      </select>
    </div>
    <div style="color:var(--cyan);font-size:1.3rem;padding-bottom:10px;flex-shrink:0;">→</div>
    <div class="field" style="flex:1;">
      <label>Destino</label>
      <select id="sel-dest" onchange="onDestChange()">
        <option value="">— Elegí —</option>
      </select>
    </div>
  </div>

  <!-- 3. HORA + DIA -->
  <div class="controls" style="margin-bottom:12px;">
    <div class="field">
      <label>Desde hora</label>
      <input type="time" id="inp-hora">
    </div>
    <div class="field">
      <label>Tipo de día</label>
      <select id="sel-dia">
        <option value="lv">Lunes – Viernes</option>
        <option value="sab">Sábado</option>
        <option value="dom">Domingo / Feriado</option>
      </select>
    </div>
  </div>

  <div class="controls-row">
    <button id="btn-ahora" onclick="setNow()">🕐 AHORA</button>
    <button id="btn-consultar" onclick="consultar()">CONSULTAR</button>
  </div>

  <div id="results">
    <div class="empty-state">
      <img src="data:image/png;base64," style="width:60px;opacity:0.25;margin-bottom:10px;display:block;margin-left:auto;margin-right:auto;">
      SELECCIONÁ LÍNEA Y DIRECCIÓN<br>LUEGO PRESIONÁ CONSULTAR
    </div>
  </div>

</div>

<div class="footer">powered by <span>phantom droid</span></div>

</div>

<script>
const SCHEDULES = {
  alvarez: {
    lv: {
      ida: [
        {t:'05:15'},{t:'06:05'},{t:'06:45'},{t:'07:25'},{t:'08:00'},{t:'09:00'},
        {t:'10:00'},{t:'10:40'},{t:'11:40'},{t:'12:30'},{t:'13:30'},{t:'14:40'},
        {t:'15:35'},{t:'16:35',p:true},{t:'17:45',p:true},{t:'18:40'},{t:'19:40'},{t:'20:45'},{t:'23:05'}
      ],
      vuelta: [
        {t:'06:30',p:true},{t:'07:30',p:true},{t:'08:20',p:true},{t:'09:15'},{t:'10:00'},{t:'10:55'},
        {t:'12:00'},{t:'12:30'},{t:'13:10'},{t:'14:05'},{t:'15:05'},{t:'16:15'},
        {t:'17:10'},{t:'18:10'},{t:'19:20'},{t:'20:10'},{t:'21:10'},{t:'22:05'},{t:'00:10'}
      ]
    },
    sab: {
      ida: [
        {t:'06:45'},{t:'08:00'},{t:'09:40'},{t:'10:40'},{t:'12:45'},{t:'14:10',p:true},
        {t:'15:35',p:true},{t:'17:30',p:true},{t:'18:40'},{t:'20:25'}
      ],
      vuelta: [
        {t:'08:20',p:true},{t:'09:20',p:true},{t:'11:20'},{t:'12:40'},{t:'14:10'},{t:'15:40'},
        {t:'17:20'},{t:'19:00'},{t:'20:20'},{t:'21:50'}
      ]
    },
    dom: {
      ida: [
        {t:'06:45'},{t:'08:00'},{t:'09:40'},{t:'10:40'},{t:'12:45'},{t:'14:10',p:true},
        {t:'15:35',p:true},{t:'17:30',p:true},{t:'18:40'},{t:'20:25'}
      ],
      vuelta: [
        {t:'08:20',p:true},{t:'09:20',p:true},{t:'11:20'},{t:'12:40'},{t:'14:10'},{t:'15:40'},
        {t:'17:20'},{t:'19:00'},{t:'20:20'},{t:'21:50'}
      ]
    }
  },
  acebal: {
    lv: {
      ida: [
        {t:'06:30'},{t:'06:31'},{t:'08:00'},{t:'10:05'},{t:'11:30'},{t:'13:00'},
        {t:'13:50'},{t:'15:05'},{t:'16:35'},{t:'17:30'},{t:'18:40'},{t:'20:00'}
      ],
      vuelta: [
        {t:'06:10'},{t:'08:15'},{t:'09:45'},{t:'11:00'},{t:'12:00'},{t:'13:15'},
        {t:'14:50'},{t:'15:40'},{t:'17:00'},{t:'18:20'},{t:'19:20'},{t:'21:00'}
      ]
    },
    sab: {
      ida: [{t:'06:30'},{t:'08:30'},{t:'09:40'},{t:'11:40'},{t:'13:00'},{t:'15:00'},{t:'19:30'}],
      vuelta: [{t:'08:15'},{t:'10:00'},{t:'11:10'},{t:'13:10'},{t:'13:11'},{t:'17:30'},{t:'17:31'},{t:'21:00'}]
    },
    dom: {
      ida: [{t:'06:30'},{t:'08:30'},{t:'09:40'},{t:'11:40'},{t:'13:00'},{t:'15:00'},{t:'19:30'},{t:'19:31'}],
      vuelta: [{t:'08:15'},{t:'10:00'},{t:'11:10'},{t:'13:10'},{t:'17:30'},{t:'18:00'},{t:'21:00'}]
    }
  }
};

const pad = n => String(n).padStart(2,'0');
const timeToMin = t => { const [h,m]=t.split(':').map(Number); return h*60+m; };

function getNow(){ return new Date(); }

function updateClock(){
  const n=getNow();
  document.getElementById('clock').textContent=`${pad(n.getHours())}:${pad(n.getMinutes())}:${pad(n.getSeconds())}`;
  const DAYS=['DOM','LUN','MAR','MIÉ','JUE','VIE','SÁB'];
  const MONTHS=['ENE','FEB','MAR','ABR','MAY','JUN','JUL','AGO','SEP','OCT','NOV','DIC'];
  document.getElementById('date-label').textContent=`${DAYS[n.getDay()]} ${pad(n.getDate())} ${MONTHS[n.getMonth()]} ${n.getFullYear()} · GMT-3`;
}
setInterval(updateClock,1000); updateClock();

function autoSetDay(){
  const d=getNow().getDay();
  document.getElementById('sel-dia').value=d===0?'dom':d===6?'sab':'lv';
}
autoSetDay();

function setNow(){
  const n=getNow();
  document.getElementById('inp-hora').value=`${pad(n.getHours())}:${pad(n.getMinutes())}`;
  autoSetDay(); consultar();
}

function calcCountdown(diaKey, busTimeMin){
  const now=getNow();
  const nowDow=now.getDay();
  const nowMin=now.getHours()*60+now.getMinutes()+now.getSeconds()/60;
  const targetDows=diaKey==='lv'?[1,2,3,4,5]:diaKey==='sab'?[6]:[0];
  let bestDiff=Infinity;
  for(let offset=0;offset<=7;offset++){
    const candidateDow=(nowDow+offset)%7;
    if(!targetDows.includes(candidateDow))continue;
    const diffMins=offset*1440+busTimeMin-nowMin;
    if(diffMins>0&&diffMins<bestDiff)bestDiff=diffMins;
  }
  if(bestDiff===Infinity||bestDiff<=0)return'AHORA';
  const totalSec=Math.round(bestDiff*60);
  const d=Math.floor(totalSec/86400);
  const h=Math.floor((totalSec%86400)/3600);
  const m=Math.floor((totalSec%3600)/60);
  const s=totalSec%60;
  if(d>0)return`en ${d}d ${pad(h)}h ${pad(m)}m`;
  if(h>0)return`en ${h}h ${pad(m)}m ${pad(s)}s`;
  if(m>0)return`en ${m}m ${pad(s)}s`;
  return`en ${s}s`;
}

// GPS
let userLat=null,userLon=null;

function getInstrucciones(){
  const ua=navigator.userAgent;
  if(/iPhone|iPad|iPod/.test(ua)) return {
    title:'📍 Cómo habilitar en iPhone/iPad:',
    steps:['Abrí <strong>Ajustes</strong> del celular','Ir a <strong>Privacidad y seguridad → Localización</strong>','Buscá tu navegador (<strong>Safari</strong> o <strong>Chrome</strong>)','Cambialo a <strong>"Al usar la app"</strong>','Volvé acá y tocá <strong>DETECTAR</strong> de nuevo']
  };
  if(/Android/.test(ua)) return {
    title:'📍 Cómo habilitar en Android:',
    steps:['Tocá el ícono 🔒 o ⓘ en la <strong>barra de dirección</strong>','Tocá <strong>Permisos → Ubicación</strong>','Seleccioná <strong>Permitir</strong>','Recargá la página y tocá <strong>DETECTAR</strong> de nuevo']
  };
  return {
    title:'📍 Cómo habilitar en el navegador:',
    steps:['Hacé clic en 🔒 o ⓘ en la <strong>barra de dirección</strong>','Buscá <strong>Ubicación</strong> → cambialo a <strong>Permitir</strong>','Recargá y tocá <strong>DETECTAR</strong> de nuevo']
  };
}

function mostrarInstrucciones(){
  const i=getInstrucciones();
  document.getElementById('gps-extra').innerHTML=`<div class="gps-instrucciones"><strong>${i.title}</strong><ol>${i.steps.map(s=>`<li>${s}</li>`).join('')}</ol></div>`;
}



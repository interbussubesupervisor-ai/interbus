// ─── SMART LOCATION DETECTION ────────────────────────────────
function distKm(lat1,lon1,lat2,lon2){
  const R=6371;
  const dLat=(lat2-lat1)*Math.PI/180;
  const dLon=(lon2-lon1)*Math.PI/180;
  const a=Math.sin(dLat/2)**2+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}

function nearestStop(lat,lon,stops){
  let best=null,bestD=Infinity;
  for(const s of stops){
    const d=distKm(lat,lon,s.lat,s.lon);
    if(d<bestD){bestD=d;best={...s,dist:d};}
  }
  return best;
}

function distToRoute(lat,lon,route){
  let minD=Infinity;
  for(const [rlat,rlon] of route){
    const d=distKm(lat,lon,rlat,rlon);
    if(d<minD)minD=d;
  }
  return minD;
}

function detectLineAndDir(lat,lon){
  const nearAlv=nearestStop(lat,lon,STOPS_ALV);
  const nearAce=nearestStop(lat,lon,STOPS_ACE);
  const distAlvRoute=distToRoute(lat,lon,ROUTE_ALV);
  const distAceRoute=distToRoute(lat,lon,ROUTE_ACE);

  // Terminal Rosario coords
  const terminalLat=-32.9396, terminalLon=-60.6727;
  // Separation point: Cruce RP18 y A012
  const separationLat=-33.0881, separationLon=-60.6997;

  const distToTerminal=distKm(lat,lon,terminalLat,terminalLon);
  const distToSeparation=distKm(lat,lon,separationLat,separationLon);

  // Determine if user is in common zone (before separation point)
  const inCommonZone = distToSeparation < 15 && distToTerminal > 1;

  // Nearest stop overall
  const useAlv = nearAlv.dist <= nearAce.dist;
  const nearStop = useAlv ? nearAlv : nearAce;
  const detectedLine = useAlv ? 'alvarez' : 'acebal';

  // Determine direction: if closer to terminal = vuelta, else = ida
  const endAlvLat=-33.1291, endAlvLon=-60.8027; // Álvarez town center
  const endAceLat=-33.2417, endAceLon=-60.8360; // Acebal town center
  const distToEndAlv=distKm(lat,lon,endAlvLat,endAlvLon);
  const distToEndAce=distKm(lat,lon,endAceLat,endAceLon);
  
  let dir='ida';
  if(distToTerminal < 3) dir='vuelta'; // near terminal = coming back
  else if(detectedLine==='alvarez' && distToEndAlv < distToTerminal) dir='vuelta';
  else if(detectedLine==='acebal' && distToEndAce < distToTerminal) dir='vuelta';

  return {
    linea: detectedLine,
    dir: dir,
    nearestStop: nearStop.name,
    distMeters: Math.round(nearStop.dist*1000),
    inCommonZone: inCommonZone
  };
}

function doGetPosition(){
  const dot=document.getElementById('gps-dot'),txt=document.getElementById('gps-text');
  navigator.geolocation.getCurrentPosition(pos=>{
    userLat=pos.coords.latitude; userLon=pos.coords.longitude;
    dot.className='gps-dot active';
    document.getElementById('gps-extra').innerHTML='';

    const result = detectLineAndDir(userLat, userLon);

    // Set line and direction
    setLinea(result.linea);

    // Smart status message
    const lineaName = result.linea==='alvarez'?'ÁLVAREZ':'ACEBAL';
    const dirName = result.dir==='ida'?'→ A ROSARIO':'← A '+lineaName;
    const distStr = result.distMeters < 1000
      ? `${result.distMeters}m de "${result.nearestStop}"`
      : `${(result.distMeters/1000).toFixed(1)}km de "${result.nearestStop}"`;

    let msg = `📍 Línea ${lineaName} ${dirName} · ${distStr}`;
    if(result.inCommonZone){
      msg += ' · ⚠️ Tramo común – verificá la línea';
    }
    txt.textContent = msg;
    showMap(userLat, userLon, result.nearestStop, result.distMeters);
      },err=>{
    dot.className='gps-dot error';
    if(err.code===1){txt.textContent='⚠️ Permiso denegado – seguí los pasos ↓';mostrarInstrucciones();}
    else if(err.code===2){txt.textContent='⚠️ Señal GPS no disponible – intentá al aire libre';}
    else{txt.textContent='⚠️ Tiempo agotado – intentá de nuevo';}
  },{timeout:10000,enableHighAccuracy:true});
}

function getLocation(){
  const dot=document.getElementById('gps-dot'),txt=document.getElementById('gps-text');
  document.getElementById('gps-extra').innerHTML='';
  if(!navigator.geolocation){dot.className='gps-dot error';txt.textContent='GPS no disponible';return;}
  txt.textContent='Detectando ubicación...'; dot.className='gps-dot';
  doGetPosition();
}


// ─── STOPS TABLE ──────────────────────────────────────────────
// Each stop has:
//   minFromTerminus : minutes from line's own terminus (Álvarez or Acebal) to this stop
//   minFromRosario  : minutes from Rosario terminal to this stop
// Stops ordered terminus → Rosario

const ALL_STOPS = {
  alvarez: [
    // IDA: Álvarez→Rosario timings (minFromTerminus)
    // VUELTA: Rosario→Álvarez timings (minFromRosario)
    {name:'ÁLVAREZ',     minFromTerminus:0,  minFromRosario:85},
    {name:'PIÑERO',      minFromTerminus:10, minFromRosario:75},
    {name:'LOS MUCHACHOS',minFromTerminus:22, minFromRosario:64},
    {name:'LA CAROLINA', minFromTerminus:25, minFromRosario:60},
    {name:'ROSARIO',     minFromTerminus:85, minFromRosario:0}
  ],
  acebal: [
    // IDA: Acebal→Rosario timings
    // VUELTA: Rosario→Acebal timings
    {name:'ACEBAL',                minFromTerminus:0,  minFromRosario:100},
    {name:'C. DEL SAUCE',          minFromTerminus:3,  minFromRosario:97},
    {name:'4 ESQUINAS',            minFromTerminus:5,  minFromRosario:95},
    {name:'CNEL. DOMÍNGUEZ',       minFromTerminus:8,  minFromRosario:92},
    {name:'LOS PINOS/VILLA AMELIA',minFromTerminus:13, minFromRosario:87},
    {name:'LA CAROLINA',           minFromTerminus:33, minFromRosario:57},
    {name:'ROSARIO',               minFromTerminus:60, minFromRosario:0}
  ]
};

let currentLinea = 'alvarez';

function setLinea(val){
  currentLinea = val;
  document.getElementById('sel-linea').value = val;
  document.getElementById('tab-alvarez').classList.toggle('active', val==='alvarez');
  document.getElementById('tab-acebal').classList.toggle('active',  val==='acebal');
  // Reset origen/dest
  const selOrigen = document.getElementById('sel-origen');
  const selDest   = document.getElementById('sel-dest');
  selOrigen.innerHTML = '<option value="">— Elegí —</option>';
  selDest.innerHTML   = '<option value="">— Elegí —</option>';
  document.getElementById('sel-dir').value = '';
  // Populate origen
  ALL_STOPS[val].forEach((s,i)=>{
    const o = document.createElement('option');
    o.value = i; o.textContent = s.name;
    selOrigen.appendChild(o);
  });
}

function onOrigenChange(){
  const stops = ALL_STOPS[currentLinea];
  const oi = parseInt(document.getElementById('sel-origen').value);
  const selDest = document.getElementById('sel-dest');
  selDest.innerHTML = '<option value="">— Elegí —</option>';
  document.getElementById('sel-dir').value = '';
  if(isNaN(oi)) return;

  const towardRosario  = stops.slice(oi+1);           // stops after origen
  const towardTerminus = stops.slice(0, oi).reverse(); // stops before origen

  if(towardRosario.length > 0){
    const g = document.createElement('optgroup');
    g.label = '→ Hacia Rosario';
    towardRosario.forEach((s, i) => {
      const destIdx = oi + 1 + i;
      // IDA: tiempo = minFromTerminus[dest] - minFromTerminus[origen]
      const travelMin = s.minFromTerminus - stops[oi].minFromTerminus;
      const o = document.createElement('option');
      o.value = JSON.stringify({destIdx, dir:'ida', travelMin});
      o.textContent = s.name;
      g.appendChild(o);
    });
    selDest.appendChild(g);
  }

  if(towardTerminus.length > 0){
    const g = document.createElement('optgroup');
    g.label = '← Hacia ' + stops[0].name;
    towardTerminus.forEach((s, i) => {
      const destIdx = oi - 1 - i;
      // VUELTA: tiempo = minFromRosario[dest] - minFromRosario[origen]
      // dest has HIGHER minFromRosario (further from Rosario)
      const travelMin = s.minFromRosario - stops[oi].minFromRosario;
      const o = document.createElement('option');
      o.value = JSON.stringify({destIdx, dir:'vuelta', travelMin});
      o.textContent = s.name;
      g.appendChild(o);
    });
    selDest.appendChild(g);
  }
}

function onDestChange(){
  const raw = document.getElementById('sel-dest').value;
  if(!raw) return;
  try {
    const {dir} = JSON.parse(raw);
    document.getElementById('sel-dir').value = dir;
  } catch(e){}
}

function getStopMinutes(){
  const raw = document.getElementById('sel-dest').value;
  if(!raw) return null;
  try {
    const {travelMin, dir} = JSON.parse(raw);
    const stops = ALL_STOPS[currentLinea];
    const oi = parseInt(document.getElementById('sel-origen').value);
    const {destIdx} = JSON.parse(raw);
    return {travelMin, destName: stops[destIdx].name, dir};
  } catch(e){ return null; }
}


// ─── MAP ──────────────────────────────────────────────────────
let map = null, mapMarker = null;

function showMap(lat, lon, nearestStop, distMeters){
  const container = document.getElementById('map-container');
  container.classList.add('show');
  
  if(!map){
    map = L.map('map', {zoomControl:false, attributionControl:false}).setView([lat,lon], 14);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {maxZoom:18}).addTo(map);
  } else {
    map.setView([lat,lon], 14);
  }

  if(mapMarker) map.removeLayer(mapMarker);

  // Custom marker
  const icon = L.divIcon({
    html: `<div style="background:#29b6f6;width:16px;height:16px;border-radius:50%;border:3px solid white;box-shadow:0 0 8px rgba(41,182,246,0.8)"></div>`,
    iconSize:[16,16], iconAnchor:[8,8], className:''
  });
  mapMarker = L.marker([lat,lon], {icon}).addTo(map);

  // Add nearby stops as small dots
  const stops = currentLinea === 'alvarez' ? STOPS_ALV : STOPS_ACE;
  stops.forEach(s => {
    const d = Math.sqrt((lat-s.lat)**2+(lon-s.lon)**2)*111;
    if(d < 2){
      const dotIcon = L.divIcon({
        html:`<div style="background:#1565c0;width:8px;height:8px;border-radius:50%;border:2px solid rgba(255,255,255,0.5)" title="${s.name}"></div>`,
        iconSize:[8,8], iconAnchor:[4,4], className:''
      });
      L.marker([s.lat,s.lon],{icon:dotIcon}).bindTooltip(s.name,{permanent:false,direction:'top'}).addTo(map);
    }
  });

  const distStr = distMeters < 1000 ? `${distMeters}m` : `${(distMeters/1000).toFixed(1)}km`;
  document.getElementById('map-label').textContent = `📍 ${nearestStop} · a ${distStr}`;
  
  setTimeout(()=>map.invalidateSize(),100);
}

function consultar(){
  const linea = document.getElementById('sel-linea').value || 'alvarez';
  const diaKey = document.getElementById('sel-dia').value;
  const horaVal = document.getElementById('inp-hora').value;
  if(!horaVal){ alert('Ingresá una hora'); return; }
  // dir comes from onDestChange setting sel-dir; default ida
  const dir = document.getElementById('sel-dir').value || 'ida';
  const fromMin=timeToMin(horaVal);
  const now=getNow();
  const lineaName=linea==='alvarez'?'ÁLVAREZ':'ACEBAL';
  const dirName=dir==='ida'?`${lineaName} → ROSARIO`:`ROSARIO → ${lineaName}`;
  const diaName=diaKey==='lv'?'LUN-VIE':diaKey==='sab'?'SÁBADO':'DOM/FER';
  const sorted=[...SCHEDULES[linea][diaKey][dir]].sort((a,b)=>timeToMin(a.t)-timeToMin(b.t));
  const upcoming=sorted.filter(b=>timeToMin(b.t)>=fromMin).slice(0,3);
  let html=`<div class="result-header"><div><div class="result-title">${dirName}</div><div class="result-subtitle">${diaName} · DESDE ${horaVal}</div></div>${upcoming.length>0?`<div class="next-badge">PRÓXIMOS ${upcoming.length}</div>`:''}</div><div class="schedule-grid">`;
  if(upcoming.length===0){
    html+=`<div class="empty-state"><span class="empty-icon">🌙</span>SIN MÁS SERVICIOS<br>PARA ESTE HORARIO</div>`;
  }
  upcoming.forEach((bus,idx)=>{
    const tMin=timeToMin(bus.t);
    const cd=calcCountdown(diaKey,tMin);
    const isNext=idx===0;
    const isSoon=!isNext&&cd.includes('m ')&&!cd.includes('d ')&&!cd.includes('h ');
    const cls=isNext?"next":(isSoon?"soon":"");
    // Destination arrival time
    const stopInfo = getStopMinutes();
    let arrivalHtml = '';
    if(stopInfo){
      const arrMin = (tMin + stopInfo.travelMin) % 1440;
      const arrH = Math.floor(arrMin/60), arrM = arrMin%60;
      const arrTime = String(arrH).padStart(2,'0')+':'+String(arrM).padStart(2,'0');
      arrivalHtml = `<div class="arrival-info">🏁 ${stopInfo.destName} ~ ${arrTime} (+${stopInfo.travelMin} min)</div>`;
    }
    html+=`<div class="bus-row ${cls}"><div class="bus-time">${bus.t}</div><div class="bus-info"><div class="bus-linea">${lineaName} · ${diaName}</div>${arrivalHtml}</div>${bus.p?'<div class="p-badge">POR PENITENCIARÍA</div>':''}<div class="bus-countdown">${cd}</div></div>`;
  });
  html+=`</div><button id="btn-nueva" onclick="nuevaConsulta()">↩ NUEVA CONSULTA</button>`;
  document.getElementById('results').innerHTML=html;
}

function nuevaConsulta(){
  document.getElementById('sel-linea').value='alvarez';
  document.getElementById('sel-dir').value='ida';
  document.getElementById('inp-hora').value='';
  autoSetDay();
  document.getElementById('results').innerHTML=`<div class="empty-state"><img src="data:image/png;base64," style="width:60px;opacity:0.25;margin-bottom:10px;display:block;margin-left:auto;margin-right:auto;">SELECCIONÁ LÍNEA Y DIRECCIÓN<br>LUEGO PRESIONÁ CONSULTAR</div>`;
  document.getElementById('map-container').classList.remove('show');
  document.getElementById('gps-dot').className='gps-dot';
  document.getElementById('gps-text').textContent='Ubicación no detectada';
  document.getElementById('gps-extra').innerHTML='';
  userLat=null; userLon=null;
}

// PWA Install
let deferredPrompt=null;
window.addEventListener('beforeinstallprompt',e=>{
  e.preventDefault(); deferredPrompt=e;
  document.getElementById('install-banner').classList.add('show');
});
document.getElementById('btn-install').addEventListener('click',()=>{
  if(!deferredPrompt)return;
  deferredPrompt.prompt();
  deferredPrompt.userChoice.then(()=>{
    deferredPrompt=null;
    document.getElementById('install-banner').classList.remove('show');
  });
});
window.addEventListener('appinstalled',()=>{
  document.getElementById('install-banner').classList.remove('show');
});

// Service Worker
setLinea('alvarez');

if('serviceWorker' in navigator){
  window.addEventListener('load',()=>{
    navigator.serviceWorker.register('/sw.js').catch(()=>{});
  });
}
</script>
</body>
</html>
